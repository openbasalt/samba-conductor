# rpmlint filters for the conductor packages (packaging/rpmlint.sh runs
# Fedora 44's rpmlint with --strict). Each filter says why it is right here.

# The binaries are static Go programs by design: CGO off, built with the
# upstream Go toolchain, one artifact for every supported distribution (the
# same binaries as the .deb). No libc to track.
addFilter(r"statically-linked-binary /usr/bin/conductor")
# Not position independent: the Go linker's default executable mode, the
# same binaries as the .deb (building them with -buildmode=pie is an open
# decision, https://github.com/openbasalt/samba-conductor-docs/blob/main/packaging.md).
addFilter(r"position-independent-executable-suggested /usr/bin/conductor")
# The "conductor" system user and group come from the package's own
# sysusers.d entry (created in %pre); Fedora's registry of standard users
# lists distribution packages only.
addFilter(r"non-standard-(uid|gid) /(etc|var/lib)/conductor")
# Restricted on purpose: the configuration (it names the backup account and
# paths) and the TLS directory are for root and the conductor group only.
addFilter(r"non-standard-dir-perm /etc/conductor(/tls)? 750")
addFilter(r"non-readable /etc/conductor/helper.toml 640")
# The SELinux scriptlets are Fedora's own %selinux_relabel_pre/_post and
# %selinux_modules_uninstall macros: a copy of the file contexts is taken
# before the module changes and removed after the relabel.
addFilter(r"conductor-selinux\.noarch: E: dangerous-command-in-%(pre|postun) cp")
addFilter(r"conductor-selinux\.noarch: E: dangerous-command-in-%posttrans rm")
