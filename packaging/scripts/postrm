#!/bin/sh
# postrm of conductor. Purge deletes the configuration, the credentials
# (TOTP key: back it up first, see docs/restore.md), the state (database,
# audit log) and the bookkeeping.
# The system user is kept: files it owns may exist elsewhere (backups,
# copies), and a reused UID would own them.
set -e

ENABLE="conductor-helper.service conductor.service conductor-mfa.socket"

case "$1" in
remove)
	if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
	fi
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper mask $ENABLE >/dev/null || true
	fi
	;;
purge)
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper purge $ENABLE >/dev/null || true
		deb-systemd-helper unmask $ENABLE >/dev/null || true
	fi
	for path in /etc/conductor/helper.toml /etc/conductor; do
		if dpkg-statoverride --list "$path" >/dev/null 2>&1; then
			dpkg-statoverride --remove "$path"
		fi
	done
	rm -rf /etc/systemd/system/conductor.service.d /etc/systemd/system/conductor-helper.service.d
	rm -rf /etc/conductor /var/lib/conductor /run/conductor-helper
	if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
	fi
	;;
esac

exit 0
