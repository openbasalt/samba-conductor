#!/bin/sh
# %post of conductor (RPM), as Fedora's %systemd_post: on a fresh install
# the units get their preset state. The distribution's default preset
# disables them (Fedora and Basalt OS: 99-default-disable.preset), so
# nothing is enabled or started: conductor needs "conductor setup" first.
# systemd's own file triggers reload the manager at the end of the
# transaction.
UNITS="conductor-helper.service conductor.service conductor-mfa.socket"
# The audit chain's key (LoadCredential=audit-key in conductor.service),
# created once, on install or before an upgrade restarts conductor
# (%postun). "conductor setup" keeps an existing one.
key=/etc/conductor/credentials/audit-key
if [ -d /etc/conductor/credentials ] && [ ! -e "$key" ]; then
	(umask 077 && { od -An -tx1 -N32 /dev/urandom | tr -d ' \n'; echo; } >"$key.new" && mv "$key.new" "$key") || :
fi
if [ "$1" -eq 1 ]; then
	if [ -x /usr/lib/systemd/systemd-update-helper ]; then
		/usr/lib/systemd/systemd-update-helper install-system-units $UNITS || :
	else
		systemctl --no-reload preset $UNITS >/dev/null 2>&1 || :
	fi
fi
exit 0
