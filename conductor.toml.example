# Samba Conductor configuration (/etc/conductor/conductor.toml).
# `conductor setup` writes this file for you; reference: docs/config.md.
# Unknown keys are rejected, so a typo never silently falls back to a default.

[server]
# Built-in TLS (the certificate must be readable by the conductor user).
listen = ":8443"
tls_cert = "/etc/conductor/tls/cert.pem"
tls_key = "/etc/conductor/tls/key.pem"
# Or behind a TLS reverse proxy on the same host (loopback only).
# trusted_proxies is required with behind_proxy: the proxy's addresses,
# whose X-Forwarded-For gives the client address used by rate limits and
# the audit log.
# listen = "127.0.0.1:8080"
# behind_proxy = true
# trusted_proxies = ["127.0.0.1/32", "::1/128"]
# The https URL users open. Enrollment links are built from it (default:
# the WebAuthn origin when webauthn.rp_id is set; without either, the web
# pages issue no enrollment link and the enroll-link command needs
# --base-url).
# public_url = "https://dc1.example.com:8443"

[domain]
realm = "EXAMPLE.COM"
# The CA that signs the DCs' LDAPS certificates; nothing else is trusted.
ca_file = "/etc/conductor/domain-ca.pem"
# Try the local DC first; empty dcs = discover DCs through DNS SRV records.
preferred = ["dc1.example.com"]
dcs = []
# DNS servers for SRV discovery when the host resolver is not the domain DNS.
dns_servers = []
# LDAP simple bind when Kerberos is unreachable (password kept encrypted in
# memory for the session). Leave off unless you need it.
simple_bind_fallback = false

[roles]
# AD group SIDs. Empty admin_groups = the domain's Domain Admins (RID 512).
admin_groups = []
helpdesk_groups = ["S-1-5-21-1111111111-2222222222-3333333333-1105"]
auditor_groups = []
# Roles are re-checked against AD at most this often (0-60 seconds).
cache_seconds = 60

[mfa]
# Two-factor authentication for users without a privileged role:
# off, optional or required. Administrators always need it.
policy = "optional"
# Helpdesk and auditors need 2FA too.
delegated_roles_required = true
# Administrators without 2FA enroll only through a one-time link
# (`conductor enroll-link`, or issued by another administrator).
admin_enrollment_requires_link = true
issuer = "Samba Conductor"
# Key that encrypts TOTP secrets. Empty: $CREDENTIALS_DIRECTORY/totp-key
# (systemd LoadCredential, as in the shipped unit).
key_file = ""

[session]
idle_minutes = 15
absolute_hours = 8

[ratelimit]
per_ip_per_minute = 30
account_failures = 5
account_window_minutes = 15

[state]
database = "/var/lib/conductor/conductor.db"

[helper]
enabled = true
socket = "/run/conductor-helper/helper.sock"

[ui]
default_language = "en"   # or "pt-BR"

[webauthn]
# Security keys and platform authenticators as a second factor. rp_id is
# the host name users open conductor with; empty turns WebAuthn off.
rp_id = ""
# origins = ["https://conductor.example.com:8443"]   # default: from rp_id + listen port
display_name = "Samba Conductor"
# Administrators must sign in with a security key (TOTP refused for them).
admin_required = false
# To let conductor-idp use the same keys (passkeys), rp_id must be a domain
# both hosts are under (rp_id = "example.com", origins =
# ["https://conductor.example.com:8443", "https://idp.example.com:9443"]).
# Origins on another domain go in related_origins (served at
# https://<rp_id>/.well-known/webauthn, so conductor must answer on rp_id).
# related_origins = []

[bulk]
# Most rows per CSV import or action on selected accounts.
max_rows = 1000

[tools]
# Run for GPO creation/deletion with the signed-in user's Kerberos ticket.
samba_tool = "/usr/bin/samba-tool"

[sync]
# The "Google Workspace sync" section (administrators only): conductor
# drives conductor-sync through its local management API
# (`conductor-sync serve`, conductor-sync's docs/usage-p5.md). The socket
# admits only the conductor user (SO_PEERCRED).
enabled = false
socket = "/run/conductor-sync/api.sock"

[idp]
# The "Single sign-on" section (administrators only): conductor drives
# conductor-idp through its local management API (conductor-idp's
# [api], conductor-idp-api.socket). The socket admits only the conductor
# user (SO_PEERCRED).
enabled = false
socket = "/run/conductor-idp/api.sock"
# Serve conductor's second factor to conductor-idp on this host (one
# enrollment and policy for both; conductor-mfa.socket, and
# mfa.backend = "conductor" in idp.toml). Only the conductor-idp user may
# connect.
mfa_socket = false
# mfa_socket_path = "/run/conductor/mfa.sock"   # used when systemd passes no socket
# mfa_socket_group = "conductor-idp"            # group of a socket conductor creates
# mfa_allowed_users = ["conductor-idp"]

[branding]
# Template overrides of the self-service pages (docs/branding.md):
# header.html, footer.html, self-home.html and an optional custom.css.
# Unset: none. The organization name, logos, colors and texts are edited
# in the admin UI (Settings > Branding).
# templates_dir = "/etc/conductor/templates"
# Origins the branded pages may load images and fonts from (CSP img-src
# and font-src of those pages only). Unset: this origin only.
# allowed_origins = ["https://cdn.example.com"]

[mail]
# The SMTP relay conductor sends its messages through (docs/mail.md).
# Unset host: e-mail is off.
# host = "smtp.example.com"
# port = 587
# starttls (required, never downgraded), tls (port 465) or none (plain
# SMTP, only to a relay on this machine: localhost, 127.0.0.1, ::1).
# security = "starttls"
# AUTH PLAIN user; empty: no authentication. The password comes from the
# systemd credential "smtp-password" or from password_file.
# username = ""
# password_file = ""
# from = "Samba Conductor <no-reply@example.com>"
# reply_to = ""
# hello_name = ""        # EHLO name; default the host name
# ca_file = ""           # extra CA for the relay's certificate; default system roots
# max_per_hour = 200     # global ceiling; above it messages wait in the queue

[provisioner]
# conductor-provisioner: the local service that holds the delegated AD
# account behind invitations and password resets by e-mail
# (docs/passwords.md). Both features also need [mail]. Their settings
# (link lifetimes, the public reset form, second factor at reset,
# notifications) are edited in Settings > Passwords. With [sync] too, it
# also applies the plans of the Google-first mode (docs/google-first.md),
# whose settings live in conductor-sync and are edited in the sync section.
# enabled = false
# socket = "/run/conductor-provisioner/api.sock"
